# ── Storage: Turso (libSQL / SQLite) ─────────────────────────────
# Local dev: a file DB, no token needed. Create it with `pnpm db:migrate`.
# Production: libsql://<db>-<org>.turso.io + token from `turso db tokens create <db>`.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ── Auth ─────────────────────────────────────────────────────────
# Long random string that signs the session cookie: `openssl rand -base64 32`
AUTH_SECRET=

# The two people of the app. Each one logs in with their own PIN (6 digits recommended).
USER_A_NAME=Alejandro
USER_A_PIN=
USER_B_NAME=Claudia
USER_B_PIN=
